#compdef fos

_fos() {
  local output value description
  local -a request values descriptions
  request=("${(@)words[2,CURRENT]}")
  output="$(@timeout@ 2s fos __complete "${request[@]}" 2>/dev/null || true)"
  values=()
  descriptions=()
  while IFS=$'\t' read -r value description; do
    if [[ -n $value ]]; then
      values+=("$value")
      descriptions+=("$description")
    fi
  done <<<"$output"
  if (( ${#values[@]} )); then
    compadd -d descriptions -- "${values[@]}"
  fi
}

_fos "$@"
