{
  "apps": {"icon":"󰀻","label":"Apps","description":"Browse installed applications","provider":"apps"},
  "controls": {"icon":"󰒓","label":"Controls","description":"Open desktop controls and helpers"},
  "capture": {"icon":"","label":"Capture","description":"Take screenshots, read text, and record the screen"},
  "network": {"icon":"󰖩","label":"Network","description":"Manage networking, VPN, and Tailscale"},
  "nixos": {"icon":"","label":"NixOS","description":"Build, activate, and inspect NixOS generations"},
  "hardware": {"icon":"󰍛","label":"Hardware","description":"Inspect system hardware"},
  "tools": {"icon":"󰧑","label":"Tools","description":"Launch applications and system diagnostics"},
  "system": {"icon":"","label":"System","description":"Lock, leave, or power off the system"},

  "controls.audio": {"icon":"󰕾","label":"Audio","description":"Open audio controls","action":"fos menu audio"},
  "controls.network": {"icon":"󰖩","label":"Network","description":"Open network controls","action":"fos menu network"},
  "controls.bluetooth": {"icon":"","label":"Bluetooth","description":"Open Bluetooth controls","action":"fos menu bluetooth"},
  "controls.display": {"icon":"󰍹","label":"Display","description":"Open display controls","action":"fos menu display"},
  "controls.power": {"icon":"󰐥","label":"Power","description":"Open power and battery controls","action":"fos menu power"},
  "controls.notifications": {"icon":"󰂚","label":"Notifications","description":"Open notification history","action":"fos menu notifications"},
  "controls.reminders": {"icon":"󰃭","label":"Reminders","description":"Open reminders","action":"fos menu reminders"},
  "controls.clipboard": {"icon":"󰅍","label":"Clipboard","description":"Open clipboard history","action":"fos menu clipboard"},
  "controls.agents": {"icon":"󰚩","label":"Agents","description":"Open the agents menu","action":"fos menu agents"},
  "controls.clock": {"icon":"󰥔","label":"Clock","description":"Open clock controls","action":"fos menu clock"},
  "controls.keybindings": {"icon":"","label":"Keybindings","description":"Search desktop keybindings","action":"fos menu keybindings"},

  "capture.screenshot": {"icon":"","label":"Screenshots","description":"Capture a region, window, or monitor"},
  "capture.screenshot.smart": {"icon":"󰹑","label":"Smart","description":"Capture a region, window, or monitor","action":"fos capture screenshot smart"},
  "capture.screenshot.region": {"icon":"󰹑","label":"Region","description":"Capture a selected region","action":"fos capture screenshot region"},
  "capture.screenshot.window": {"icon":"","label":"Window","description":"Capture a selected window","action":"fos capture screenshot window"},
  "capture.screenshot.screen": {"icon":"󰍹","label":"Monitor","description":"Capture the focused monitor","action":"fos capture screenshot screen"},
  "capture.ocr": {"icon":"󰴑","label":"OCR Region","description":"Copy text from a selected region","action":"fos capture ocr region"},
  "capture.color": {"icon":"󰃉","label":"Color","description":"Copy a selected color","action":"fos capture color"},
  "capture.record": {"icon":"","label":"Recording","description":"Start, inspect, or stop a screen recording"},
  "capture.record.region": {"icon":"󰹑","label":"Region","description":"Record a selected region without audio","action":"fos capture record start region"},
  "capture.record.region-audio": {"icon":"󰕾","label":"Region with Audio","description":"Record a selected region with audio","action":"fos capture record start region --audio"},
  "capture.record.screen": {"icon":"󰍹","label":"Screen","description":"Record the entire screen without audio","action":"fos capture record start screen"},
  "capture.record.screen-audio": {"icon":"󰕾","label":"Screen with Audio","description":"Record the entire screen with audio","action":"fos capture record start screen --audio"},
  "capture.record.status": {"icon":"󰋼","label":"Recording Status","description":"Show the active recording status","action":"fos-internal-menu-terminal capture record status"},
  "capture.record.stop": {"icon":"󰓛","label":"Stop Recording","description":"Stop the active FOS recording","action":"fos capture record stop"},

  "network.panel": {"icon":"󰖩","label":"Network Panel","description":"Open network controls","action":"fos menu network"},
  "network.vpn": {"icon":"󰖂","label":"VPN","description":"Inspect and control the VPN"},
  "network.vpn.status": {"icon":"󰋼","label":"VPN Status","description":"Show VPN connection status","action":"fos-internal-menu-terminal vpn status"},
  "network.vpn.up": {"icon":"󰁝","label":"Start VPN","description":"Start the configured VPN","action":"fos-internal-menu-terminal vpn up --yes","confirm":"Start the configured VPN?","confirmLabel":"Start"},
  "network.vpn.down": {"icon":"󰁅","label":"Stop VPN","description":"Stop the configured VPN","action":"fos-internal-menu-terminal vpn down --yes","confirm":"Stop the configured VPN?","confirmLabel":"Stop"},
  "network.tailscale": {"icon":"󰛳","label":"Tailscale","description":"Inspect and control Tailscale"},
  "network.tailscale.status": {"icon":"󰋼","label":"Tailscale Status","description":"Show Tailscale connection status","action":"fos-internal-menu-terminal tailscale status"},
  "network.tailscale.up": {"icon":"󰁝","label":"Start Tailscale","description":"Start Tailscale networking","action":"fos-internal-menu-terminal tailscale up --yes","confirm":"Start Tailscale networking?","confirmLabel":"Start"},
  "network.tailscale.down": {"icon":"󰁅","label":"Stop Tailscale","description":"Stop Tailscale networking","action":"fos-internal-menu-terminal tailscale down --yes","confirm":"Stop Tailscale networking?","confirmLabel":"Stop"},

  "nixos.build": {"icon":"󰏗","label":"Build","description":"Build the local NixOS host without activating it","action":"fos-internal-menu-terminal nixos build"},
  "nixos.test": {"icon":"󰙨","label":"Test","description":"Temporarily activate the local NixOS host","action":"fos-internal-menu-terminal nixos test"},
  "nixos.switch": {"icon":"󰜉","label":"Switch","description":"Activate and persist the local NixOS host","action":"fos-internal-menu-terminal nixos switch"},
  "nixos.update": {"icon":"","label":"Update","description":"Update inputs and build the local NixOS host","action":"fos-internal-menu-terminal nixos update","confirm":"Update flake inputs and build the local host?","confirmLabel":"Update"},
  "nixos.generations": {"icon":"󰋚","label":"Generations","description":"List NixOS generations","action":"fos-internal-menu-terminal nixos generations"},
  "nixos.rollback": {"icon":"󰕌","label":"Rollback","description":"Roll back to the previous NixOS generation","action":"fos-internal-menu-terminal nixos rollback"},

  "hardware.summary": {"icon":"󰍛","label":"Summary","description":"Show a hardware summary","action":"fos-internal-menu-terminal hardware summary"},
  "hardware.cpu": {"icon":"","label":"CPU","description":"Show processor information","action":"fos-internal-menu-terminal hardware cpu"},
  "hardware.memory": {"icon":"","label":"Memory","description":"Show memory information","action":"fos-internal-menu-terminal hardware memory"},
  "hardware.gpu": {"icon":"󰢮","label":"GPU","description":"Show graphics hardware information","action":"fos-internal-menu-terminal hardware gpu"},
  "hardware.storage": {"icon":"󰋊","label":"Storage","description":"Show storage hardware information","action":"fos-internal-menu-terminal hardware storage"},
  "hardware.sensors": {"icon":"","label":"Sensors","description":"Show temperatures and sensor readings","action":"fos-internal-menu-terminal hardware sensors"},
  "hardware.battery": {"icon":"󰁹","label":"Battery","description":"Show battery hardware information","action":"fos-internal-menu-terminal hardware battery"},
  "hardware.network": {"icon":"󰛳","label":"Network","description":"Show network hardware information","action":"fos-internal-menu-terminal hardware network"},
  "hardware.pci": {"icon":"󰮯","label":"PCI","description":"List PCI devices","action":"fos-internal-menu-terminal hardware pci"},
  "hardware.usb": {"icon":"󰕓","label":"USB","description":"List USB devices","action":"fos-internal-menu-terminal hardware usb"},
  "hardware.firmware": {"icon":"󰚰","label":"Firmware","description":"Show firmware information","action":"fos-internal-menu-terminal hardware firmware"},

  "tools.launch": {"icon":"󰐕","label":"Launch","description":"Launch common applications"},
  "tools.launch.browser": {"icon":"","label":"Browser","description":"Launch the configured browser","action":"fos launch browser"},
  "tools.launch.terminal": {"icon":"","label":"Terminal","description":"Launch the configured terminal","action":"fos launch terminal"},
  "tools.launch.editor": {"icon":"","label":"Editor","description":"Launch the configured editor","action":"fos launch editor"},
  "tools.launch.files": {"icon":"","label":"Files","description":"Launch the configured file manager","action":"fos launch files"},
  "tools.fos": {"icon":"","label":"FOS","description":"Inspect FOS and system health"},
  "tools.fos.status": {"icon":"󰋼","label":"FOS Status","description":"Show safe system status","action":"fos-internal-menu-terminal status"},
  "tools.fos.doctor": {"icon":"󰭎","label":"FOS Doctor","description":"Check FOS command backends","action":"fos-internal-menu-terminal doctor"},
  "tools.fos.stats": {"icon":"󰄧","label":"System Stats","description":"Show system statistics","action":"fos-internal-menu-terminal system stats"},
  "tools.fos.monitor": {"icon":"","label":"System Monitor","description":"Open the interactive system monitor","action":"fos-internal-menu-terminal system monitor"},

  "system.lock": {"icon":"","label":"Lock","description":"Lock the current session","action":"fos system lock"},
  "system.logout": {"icon":"󰍃","label":"Logout","description":"Log out of the current session","action":"fos system logout --yes","confirm":"Log out of the current session?","confirmLabel":"Log out"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","description":"Suspend the system","action":"fos system suspend --yes","confirm":"Suspend the system?","confirmLabel":"Suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","description":"Hibernate the system","action":"fos system hibernate --yes","confirm":"Hibernate the system?","confirmLabel":"Hibernate"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","description":"Reboot the system","action":"fos system reboot --yes","confirm":"Reboot the system?","confirmLabel":"Reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","description":"Shut down the system","action":"fos system shutdown --yes","confirm":"Shut down the system?","confirmLabel":"Shut down"}
