{
  "version": 1,
  "bar": {
    "position": "bottom",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        { "id": "omarchy.workspaces" }
      ],
      "center": [
        { "id": "omarchy.media" },
        {
          "id": "omarchy.indicators",
          "items": ["ScreenRecording", "Reminder", "Dnd", "StayAwake"]
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy"
        },
        { "id": "omarchy.weather" }
      ],
      "right": [
        { "id": "omarchy.tray" },
        {
          "id": "omarchy.agents",
          "providers": {
            "claude": { "enabled": false },
            "codex": { "enabled": true },
            "fireworks": { "enabled": false }
          }
        },
        { "id": "phfroidmont.nextcloud" },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" },
        { "id": "omarchy.tailscale" },
        { "id": "omarchy.microphone" },
        { "id": "omarchy.audio" },
        { "id": "omarchy.monitor" },
        { "id": "omarchy.power" }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.active-window",
    "omarchy.background",
    "omarchy.clipboard",
    "omarchy.dev-gallery",
    "omarchy.disk-speedtest",
    "omarchy.dropbox",
    "omarchy.emojis",
    "omarchy.idle",
    "omarchy.image-picker",
    "omarchy.keyboard-layout",
    "omarchy.lock",
    "omarchy.nightlight",
    "omarchy.polkit",
    "omarchy.system-update"
  ]
}
