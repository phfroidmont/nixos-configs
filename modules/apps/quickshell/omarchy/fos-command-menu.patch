+++ b/shell/plugins/menu/Menu.qml
@@ -81,3 +81,3 @@
-  property bool deleteConfirmOpen: false
-  property var deleteTarget: null
-  onOpenedChanged: if (!opened) { deleteConfirmOpen = false; deleteTarget = null }
+  property bool actionConfirmOpen: false
+  property var actionTarget: null
+  onOpenedChanged: if (!opened) { actionConfirmOpen = false; actionTarget = null }
@@ -754 +754 @@
-    if (root.deleteConfirmOpen) return
+    if (root.actionConfirmOpen) return
@@ -779 +779 @@
-      root.applySelected(row.itemId, row.action)
+      root.requestAction(row.itemId, row.action)
@@ -783,25 +783,32 @@
-  function requestDeleteSelected() {
-    if (!root.cursorActive || root.selectedIndex < 0 || root.selectedIndex >= displayModel.count) return
-    var row = displayModel.get(root.selectedIndex)
-    if (!row || row.kind !== "app") return
-    root.deleteTarget = { appId: row.appId, label: row.label }
-    deleteConfirm.selectedIndex = 1
-    root.deleteConfirmOpen = true
-  }
-
-  function cancelDelete() {
-    root.deleteConfirmOpen = false
-    root.deleteTarget = null
-    deleteConfirm.selectedIndex = 1
-    root.disarmPointer()
-    Qt.callLater(function() { keyCatcher.forceActiveFocus() })
-  }
-
-  function confirmDelete() {
-    var target = root.deleteTarget
-    root.deleteConfirmOpen = false
-    root.deleteTarget = null
-    if (!target) return
-    root.cancel()
-    if (root.appLibrary) root.appLibrary.remove(target.appId, target.label)
-  }
+  function requestAction(id, action) {
+    var entry = root.item(id)
+    if (!entry || !entry.confirm) {
+      root.applySelected(id, action)
+      return
+    }
+
+    root.actionTarget = {
+      id: id,
+      action: action,
+      message: String(entry.confirm),
+      confirmLabel: String(entry.confirmLabel || "Confirm")
+    }
+    actionConfirm.selectedIndex = 0
+    root.actionConfirmOpen = true
+  }
+
+  function cancelAction() {
+    root.actionConfirmOpen = false
+    root.actionTarget = null
+    actionConfirm.selectedIndex = 0
+    root.disarmPointer()
+    Qt.callLater(function() { keyCatcher.forceActiveFocus() })
+  }
+
+  function confirmAction() {
+    var target = root.actionTarget
+    root.actionConfirmOpen = false
+    root.actionTarget = null
+    if (!target) return
+    root.applySelected(target.id, target.action)
+  }
@@ -896,2 +903,7 @@
-      root.cancel()
-      root.runAction(entry.action)
+      if (entry.confirm) {
+        root.openExistingMenu(entry.parent || "root")
+        root.requestAction(entry.id, entry.action)
+      } else {
+        root.cancel()
+        root.runAction(entry.action)
+      }
@@ -1113 +1125 @@
-        z: root.deleteConfirmOpen ? 20 : 0
+        z: root.actionConfirmOpen ? 20 : 0
@@ -1118,2 +1130,2 @@
-          if (root.deleteConfirmOpen) {
