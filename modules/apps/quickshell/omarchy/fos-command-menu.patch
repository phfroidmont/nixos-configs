+          confirmText: (root.actionTarget && root.actionTarget.confirmLabel) || "Confirm"
@@ -1173,2 +1185,2 @@
-          onCanceled: root.cancelDelete()
-          onConfirmed: root.confirmDelete()
+          onCanceled: root.cancelAction()
+          onConfirmed: root.confirmAction()
