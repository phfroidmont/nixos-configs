+def read_lines(stream):
+  # select() only sees the pipe, not lines already pulled into Python's read
+  # buffer, so a response sharing a chunk with a notification would be missed.
+  # A reader thread hands over whole lines instead; None marks end of output.
+  lines = queue.Queue()
+
+  def pump():
+    for line in stream:
+      lines.put(line)
+    lines.put(None)
+
+  threading.Thread(target=pump, daemon=True).start()
+  return lines
+
